---
import type { Language } from '@/i18n';

interface Props {
  lang?: Language;
}

const { lang = 'en' } = Astro.props;
---

<button
  id="theme-toggle"
  type="button"
  class="flex items-center justify-center w-10 h-10 rounded-lg bg-[var(--bg-tertiary)] text-[var(--text-primary)] border border-[var(--border-color)] cursor-pointer transition-[background-color,transform] duration-200 hover:bg-[var(--border-color)] hover:scale-105"
  aria-label={lang === 'es' ? 'Cambiar tema de color' : 'Toggle color theme'}
  aria-pressed="false"
  data-lang={lang}
>
  <svg
    aria-hidden="true"
    class="sun-icon block dark:hidden"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>
  <svg
    aria-hidden="true"
    class="moon-icon hidden dark:block"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<script>
  function syncThemeButton(button: HTMLButtonElement, isDark: boolean) {
    const isEs = button.dataset.lang === 'es';
    button.setAttribute('aria-pressed', String(isDark));
    button.setAttribute('aria-label', isDark
      ? (isEs ? 'Usar tema claro' : 'Use light theme')
      : (isEs ? 'Usar tema oscuro' : 'Use dark theme'));
  }

  function initTheme() {
    const savedTheme = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const isDark = savedTheme === 'dark' || (!savedTheme && prefersDark);
    document.documentElement.classList.toggle('dark', isDark);
    const button = document.getElementById('theme-toggle');
    if (!(button instanceof HTMLButtonElement)) return;
    syncThemeButton(button, isDark);
    if (button.dataset.initialized === 'true') return;
    button.dataset.initialized = 'true';
    button.addEventListener('click', () => {
      const nextIsDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', nextIsDark ? 'dark' : 'light');
      syncThemeButton(button, nextIsDark);
    });
  }

  initTheme();
  document.addEventListener('astro:after-swap', initTheme);
</script>
