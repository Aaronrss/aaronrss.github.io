---
import { localizePath, type Language } from '@/i18n';
import { profile } from '@/data/profile';

interface Props { lang?: Language; }
const { lang = 'en' } = Astro.props;
const currentYear = new Date().getFullYear();

const copy = lang === 'es'
  ? {
      summary: 'Software Engineer en Ciudad de México. Backend, cloud, application delivery y sistemas que permanecen comprensibles.',
      links: 'Navegación', follow: 'Perfiles', rights: 'Todos los derechos reservados.',
      home: 'Inicio', blog: 'Blog', portfolio: 'Proyectos', about: 'Perfil', contact: 'Contacto', legacy: 'Sitio anterior',
    }
  : {
      summary: 'Software Engineer in Mexico City. Backend, cloud, application delivery, and systems that stay understandable.',
      links: 'Navigation', follow: 'Profiles', rights: 'All rights reserved.',
      home: 'Home', blog: 'Blog', portfolio: 'Projects', about: 'Profile', contact: 'Contact', legacy: 'Legacy site',
    };

const footerLinks = [
  { label: copy.home, href: localizePath('/', lang) },
  { label: copy.blog, href: localizePath('/blog', lang) },
  { label: copy.portfolio, href: localizePath('/portfolio', lang) },
  { label: copy.about, href: localizePath('/about', lang) },
  { label: copy.contact, href: localizePath('/contact', lang) },
  { label: copy.legacy, href: '/legacy/' },
];

const socialLinks = [
  { name: 'GitHub', href: profile.links.github },
  { name: 'LinkedIn', href: profile.links.linkedin },
  { name: 'X', href: profile.links.x },
  { name: 'SoundCloud', href: profile.links.soundcloud },
  { name: 'Instagram', href: profile.links.instagram },
];
---

<footer class="bg-[var(--bg-secondary)] border-t border-[var(--border-color)] pt-14 pb-8 mt-16">
  <div class="container">
    <div class="grid grid-cols-1 md:grid-cols-[2fr_1fr_1fr] gap-10 mb-12">
      <div class="max-w-xl">
        <a href={localizePath('/', lang)} class="text-xl font-bold text-[var(--text-primary)] no-underline">Aaron Rosas</a>
        <p class="mt-4 text-sm text-[var(--text-secondary)] leading-relaxed">{copy.summary}</p>
      </div>

      <div>
        <h2 class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-[var(--text-muted)] mb-4">{copy.links}</h2>
        <ul class="list-none p-0 m-0 space-y-2">
          {footerLinks.map((link) => <li><a href={link.href} class="text-sm text-[var(--text-secondary)] no-underline hover:text-[var(--color-primary-500)]">{link.label}</a></li>)}
        </ul>
      </div>

      <div>
        <h2 class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-[var(--text-muted)] mb-4">{copy.follow}</h2>
        <ul class="list-none p-0 m-0 space-y-2">
          {socialLinks.map((link) => (
            <li><a href={link.href} target="_blank" rel="noopener noreferrer" class="text-sm text-[var(--text-secondary)] no-underline hover:text-[var(--color-primary-500)]">{link.name} ↗</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-[var(--border-color)] text-sm text-[var(--text-muted)]">
      <p>&copy; {currentYear} Aaron Rosas. {copy.rights}</p>
    </div>
  </div>
</footer>
