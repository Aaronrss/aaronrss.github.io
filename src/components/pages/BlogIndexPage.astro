---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Card from '@/components/Card.astro';
import type { Language } from '@/i18n';
import { getCollection } from 'astro:content';

interface Props { lang: Language; }
const { lang } = Astro.props;
const isEs = lang === 'es';
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const copy = isEs
  ? {
      title: 'Blog',
      subtitle: 'Notas técnicas',
      description: 'Los artículos actuales están publicados en inglés. La navegación y el contexto del sitio están disponibles en ambos idiomas.',
      index: 'Índice editorial',
      count: `${posts.length} artículos publicados`,
      pageTitle: 'Blog | Aaron Rosas',
    }
  : {
      title: 'Blog',
      subtitle: 'Technical notes',
      description: 'Notes on web development, engineering practices, and the systems I am learning to build better.',
      index: 'Editorial index',
      count: `${posts.length} published articles`,
      pageTitle: 'Blog | Aaron Rosas',
    };
---

<BaseLayout title={copy.pageTitle} description={copy.description} lang={lang}>
  <Hero title={copy.title} subtitle={copy.subtitle} description={copy.description} />
  <section class="py-16 md:py-20" aria-labelledby="article-index">
    <div class="container">
      <div class="mb-10 flex flex-col gap-2 border-b border-[var(--border-color)] pb-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow">01 / Writing</p>
          <h2 id="article-index" class="mt-3 text-3xl font-bold tracking-tight text-[var(--text-primary)]">{copy.index}</h2>
        </div>
        <p class="font-mono text-xs uppercase tracking-[0.14em] text-[var(--text-muted)]">{copy.count}</p>
      </div>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <Card
            title={post.data.title}
            description={post.data.description}
            href={`/blog/${post.id}`}
            image={post.data.image}
            date={post.data.pubDate}
            category={post.data.category}
            tags={post.data.tags}
            lang={lang}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
