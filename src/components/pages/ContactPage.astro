---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import { profile } from '@/data/profile';
import type { Language } from '@/i18n';

interface Props { lang: Language; }
const { lang } = Astro.props;
const isEs = lang === 'es';

const copy = isEs
  ? {
      title: 'Contacto', subtitle: 'Conversemos', description: 'Para oportunidades profesionales, colaboración técnica o una conversación sobre sistemas.',
      send: 'Enviar un mensaje', name: 'Nombre', namePlaceholder: 'Tu nombre…', email: 'Correo', subject: 'Asunto',
      subjectPlaceholder: '¿Sobre qué quieres conversar?', message: 'Mensaje', messagePlaceholder: 'Cuéntame el contexto…',
      button: 'Enviar mensaje', sending: 'Enviando…', success: 'Mensaje enviado. Te responderé pronto.', error: 'No se pudo enviar el mensaje. Revisa tu conexión e intenta de nuevo.',
      info: 'Información de contacto', preference: 'Prefiero correo para conversaciones profesionales.', location: 'Ciudad de México', profiles: 'Perfiles públicos',
      status: 'Situación actual', statusBody: 'Actualmente trabajo como QA en Quanta, realizando auditoría técnica L2 asistida por IA, y en Application Delivery en Valores Mexicanos Casa de Bolsa (VALMEX).',
      pageTitle: 'Contacto | Aaron Rosas',
    }
  : {
      title: 'Contact', subtitle: "Let's talk", description: 'For professional opportunities, technical collaboration, or a conversation about systems.',
      send: 'Send a message', name: 'Name', namePlaceholder: 'Your name…', email: 'Email', subject: 'Subject',
      subjectPlaceholder: 'What would you like to discuss?', message: 'Message', messagePlaceholder: 'Share the context…',
      button: 'Send message', sending: 'Sending…', success: 'Message sent. I will get back to you soon.', error: 'The message could not be sent. Check your connection and try again.',
      info: 'Contact information', preference: 'I prefer email for professional conversations.', location: 'Mexico City', profiles: 'Public profiles',
      status: 'Current status', statusBody: 'I currently work in QA at Quanta, conducting AI-assisted L2 technical audits, and in Application Delivery at Valores Mexicanos Casa de Bolsa (VALMEX).',
      pageTitle: 'Contact | Aaron Rosas',
    };

const socialLinks = [
  { name: 'GitHub', url: profile.links.github },
  { name: 'LinkedIn', url: profile.links.linkedin },
  { name: 'X', url: profile.links.x },
  { name: 'SoundCloud', url: profile.links.soundcloud },
  { name: 'Instagram', url: profile.links.instagram },
];
---

<BaseLayout title={copy.pageTitle} description={copy.description} lang={lang}>
  <Hero title={copy.title} subtitle={copy.subtitle} description={copy.description} />

  <section class="py-16">
    <div class="container grid grid-cols-1 gap-12 lg:grid-cols-[1fr_380px] lg:items-start">
      <div>
        <h2 class="mb-8 text-2xl font-bold text-[var(--text-primary)]">{copy.send}</h2>
        <form id="contact-form" action="https://formspree.io/f/xldqpnzj" method="POST" class="flex flex-col gap-6" data-success={copy.success} data-error={copy.error}>
          <div class="honeypot" aria-hidden="true">
            <label for="company-website">Company website</label>
            <input type="text" id="company-website" name="_gotcha" tabindex="-1" autocomplete="off" />
          </div>
          <div class="flex flex-col gap-2">
            <label for="name" class="text-sm font-medium text-[var(--text-primary)]">{copy.name}</label>
            <input type="text" id="name" name="name" required maxlength="100" placeholder={copy.namePlaceholder} autocomplete="name" class="input-field" />
          </div>
          <div class="flex flex-col gap-2">
            <label for="email" class="text-sm font-medium text-[var(--text-primary)]">{copy.email}</label>
            <input type="email" id="email" name="email" required maxlength="254" placeholder="name@example.com" autocomplete="email" spellcheck="false" class="input-field" />
          </div>
          <div class="flex flex-col gap-2">
            <label for="subject" class="text-sm font-medium text-[var(--text-primary)]">{copy.subject}</label>
            <input type="text" id="subject" name="subject" required maxlength="160" placeholder={copy.subjectPlaceholder} autocomplete="off" class="input-field" />
          </div>
          <div class="flex flex-col gap-2">
            <label for="message" class="text-sm font-medium text-[var(--text-primary)]">{copy.message}</label>
            <textarea id="message" name="message" rows="6" required minlength="20" maxlength="5000" placeholder={copy.messagePlaceholder} autocomplete="off" class="input-field min-h-[140px] resize-y"></textarea>
          </div>
          <button type="submit" class="btn btn-primary self-start min-w-[180px]">
            <span class="btn-text">{copy.button}</span><span class="btn-loading hidden">{copy.sending}</span>
          </button>
          <div id="form-status" class="hidden rounded-lg p-4 text-sm" role="status" aria-live="polite"></div>
        </form>
      </div>

      <aside class="space-y-6 lg:sticky lg:top-24">
        <section class="rounded-2xl border border-[var(--border-color)] bg-[var(--bg-secondary)] p-6">
          <h2 class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-[var(--text-muted)]">{copy.info}</h2>
          <p class="mt-4 text-sm leading-relaxed text-[var(--text-secondary)]">{copy.preference}</p>
          <dl class="mt-6 space-y-4 border-t border-[var(--border-color)] pt-5 text-sm">
            <div><dt class="text-[var(--text-muted)]">Email</dt><dd class="mt-1"><a href={`mailto:${profile.email}`}>{profile.email}</a></dd></div>
            <div><dt class="text-[var(--text-muted)]">{isEs ? 'Ubicación' : 'Location'}</dt><dd class="mt-1 text-[var(--text-secondary)]">{copy.location}</dd></div>
          </dl>
        </section>

        <section class="rounded-2xl border border-[var(--border-color)] bg-[var(--bg-secondary)] p-6">
          <h2 class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-[var(--text-muted)]">{copy.profiles}</h2>
          <div class="mt-4 grid grid-cols-2 gap-3">
            {socialLinks.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer" class="rounded-lg border border-[var(--border-color)] px-4 py-3 text-center text-sm no-underline hover:border-[var(--color-primary-500)]">{link.name} ↗</a>)}
          </div>
        </section>

        <section class="rounded-2xl border border-[var(--border-color)] bg-gradient-to-br from-sky-500/10 to-violet-500/10 p-6">
          <h2 class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-[var(--color-primary-600)] dark:text-[var(--color-primary-300)]">{copy.status}</h2>
          <p class="mt-4 text-sm leading-relaxed text-[var(--text-secondary)]">{copy.statusBody}</p>
        </section>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .honeypot { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  #form-status.success { display: block; border: 1px solid rgb(34 197 94 / 0.3); background: rgb(34 197 94 / 0.1); color: #16a34a; }
  #form-status.error { display: block; border: 1px solid rgb(239 68 68 / 0.3); background: rgb(239 68 68 / 0.1); color: #dc2626; }
</style>

<script>
  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form || form.dataset.initialized === 'true') return;
    form.dataset.initialized = 'true';
    const status = document.getElementById('form-status');
    const buttonText = form.querySelector('.btn-text');
    const buttonLoading = form.querySelector('.btn-loading');
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      buttonText?.classList.add('hidden');
      buttonLoading?.classList.remove('hidden');
      if (submitButton) submitButton.disabled = true;
      form.setAttribute('aria-busy', 'true');
      if (status) { status.className = 'hidden rounded-lg p-4 text-sm'; status.textContent = ''; }

      try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!response.ok) throw new Error('Contact form request failed');
        if (status) { status.className = 'success rounded-lg p-4 text-sm'; status.textContent = form.dataset.success ?? ''; }
        form.reset();
      } catch {
        if (status) { status.className = 'error rounded-lg p-4 text-sm'; status.textContent = form.dataset.error ?? ''; }
      } finally {
        buttonText?.classList.remove('hidden');
        buttonLoading?.classList.add('hidden');
        if (submitButton) submitButton.disabled = false;
        form.removeAttribute('aria-busy');
      }
    });
  }
  initContactForm();
  document.addEventListener('astro:after-swap', initContactForm);
</script>
