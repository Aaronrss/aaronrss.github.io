---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Card from '@/components/Card.astro';
import type { Language } from '@/i18n';
import { getCollection } from 'astro:content';

interface Props { lang: Language; }
const { lang } = Astro.props;
const isEs = lang === 'es';
const projects = (await getCollection('portfolio')).sort((a, b) => a.data.order - b.data.order);
const published = projects.filter((project) => project.data.status === 'published');
const reserved = projects.filter((project) => project.data.status === 'placeholder');

const copy = isEs
  ? {
      title: 'Proyectos',
      subtitle: 'Trabajo publicado y espacio para lo que sigue',
      description: 'Una pieza real preservada y cascarones honestos para trabajo que todavía no quiero presentar como terminado.',
      published: 'Publicado',
      publishedSubtitle: 'Trabajo que puedes abrir y explorar hoy.',
      reserved: 'En preparación',
      reservedSubtitle: 'Líneas de trabajo reservadas hasta que tengan evidencia, decisiones y resultados que valga la pena mostrar.',
      status: 'Reservado',
      pageTitle: 'Proyectos | Aaron Rosas',
    }
  : {
      title: 'Projects',
      subtitle: 'Published work and room for what comes next',
      description: 'One preserved piece of real work and honest project shells for work I am not ready to present as finished.',
      published: 'Published',
      publishedSubtitle: 'Work you can open and explore today.',
      reserved: 'In preparation',
      reservedSubtitle: 'Reserved workstreams until they have evidence, decisions, and outcomes worth presenting.',
      status: 'Reserved',
      pageTitle: 'Projects | Aaron Rosas',
    };
---

<BaseLayout title={copy.pageTitle} description={copy.description} lang={lang}>
  <Hero title={copy.title} subtitle={copy.subtitle} description={copy.description} />

  <section class="py-16 md:py-20" aria-labelledby="published-projects">
    <div class="container">
      <div class="mb-10 max-w-2xl">
        <p class="eyebrow">01 / {copy.published}</p>
        <h2 id="published-projects" class="mt-3 text-3xl font-bold tracking-tight text-[var(--text-primary)]">{copy.published}</h2>
        <p class="mt-3 text-[var(--text-secondary)]">{copy.publishedSubtitle}</p>
      </div>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        {published.map((project) => (
          <Card
            title={isEs ? project.data.titleEs ?? project.data.title : project.data.title}
            description={isEs ? project.data.descriptionEs ?? project.data.description : project.data.description}
            image={project.data.image}
            technologies={project.data.technologies}
            github={project.data.github}
            demo={project.data.demo}
            lang={lang}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-[var(--border-color)] bg-[var(--bg-secondary)] py-16 md:py-20" aria-labelledby="reserved-projects">
    <div class="container">
      <div class="mb-10 max-w-2xl">
        <p class="eyebrow">02 / {copy.reserved}</p>
        <h2 id="reserved-projects" class="mt-3 text-3xl font-bold tracking-tight text-[var(--text-primary)]">{copy.reserved}</h2>
        <p class="mt-3 text-[var(--text-secondary)]">{copy.reservedSubtitle}</p>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
        {reserved.map((project) => (
          <Card
            title={isEs ? project.data.titleEs ?? project.data.title : project.data.title}
            description={isEs ? project.data.descriptionEs ?? project.data.description : project.data.description}
            technologies={project.data.technologies}
            placeholder
            statusLabel={copy.status}
            lang={lang}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
