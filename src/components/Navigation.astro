---
import ThemeToggle from "./ThemeToggle.astro";
import { alternateLanguagePath, localizePath, type Language } from "@/i18n";

interface Props {
  currentPath?: string;
  lang?: Language;
}

const { currentPath = "/", lang = "en" } = Astro.props;

const labels = lang === "es"
  ? { home: "Inicio", blog: "Blog", portfolio: "Proyectos", about: "Perfil", contact: "Contacto", legacy: "Sitio anterior" }
  : { home: "Home", blog: "Blog", portfolio: "Projects", about: "Profile", contact: "Contact", legacy: "Legacy site" };

const navLinks = [
  { href: localizePath("/", lang), label: labels.home, base: lang === "es" ? "/es/" : "/" },
  { href: localizePath("/blog", lang), label: labels.blog, base: lang === "es" ? "/es/blog" : "/blog" },
  { href: localizePath("/portfolio", lang), label: labels.portfolio, base: lang === "es" ? "/es/portfolio" : "/portfolio" },
  { href: localizePath("/about", lang), label: labels.about, base: lang === "es" ? "/es/about" : "/about" },
  { href: localizePath("/contact", lang), label: labels.contact, base: lang === "es" ? "/es/contact" : "/contact" },
  { href: "/legacy/", label: labels.legacy, base: "/legacy" },
];

function isActive(base: string): boolean {
  if (base === "/") return currentPath === "/";
  if (base === "/es/") return currentPath === "/es" || currentPath === "/es/";
  return currentPath.startsWith(base);
}

const languageHref = alternateLanguagePath(currentPath, lang);
const languageLabel = lang === "en" ? "ES" : "EN";
---

<header class="sticky top-0 z-50 border-b border-[var(--border-color)] backdrop-blur-sm bg-white/90 dark:bg-slate-900/90">
  <nav class="container flex items-center justify-between h-16" aria-label={lang === "es" ? "Navegación principal" : "Primary navigation"}>
    <a href={localizePath("/", lang)} class="flex items-center gap-3 no-underline">
      <span class="font-bold text-lg text-[var(--text-primary)]">Aaron Rosas</span>
      <span class="hidden sm:inline font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--text-muted)]">systems / delivery</span>
    </a>

    <button
      class="mobile-menu-btn lg:hidden flex items-center justify-center w-10 h-10 bg-transparent border-none text-[var(--text-primary)] cursor-pointer"
      id="mobile-menu-btn"
      aria-label={lang === "es" ? "Abrir menú" : "Open menu"}
      aria-controls="nav-links"
      aria-expanded="false"
    >
      <svg aria-hidden="true" class="menu-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
      <svg aria-hidden="true" class="close-icon hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12" /></svg>
    </button>

    <div class="nav-links hidden lg:flex items-center gap-4" id="nav-links">
      <ul class="flex items-center gap-1 list-none m-0 p-0">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.base) ? "page" : undefined}
              class:list={[
                "block px-3 py-2 rounded-lg text-sm font-medium transition-colors no-underline",
                isActive(link.base)
                  ? "text-[var(--color-primary-600)] bg-[var(--bg-tertiary)] dark:text-[var(--color-primary-300)]"
                  : "text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-tertiary)]",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="flex items-center gap-2">
        <a
          href={languageHref}
          class="flex items-center justify-center h-10 min-w-10 px-2 rounded-lg border border-[var(--border-color)] bg-[var(--bg-tertiary)] font-mono text-xs font-semibold text-[var(--text-primary)] no-underline hover:border-[var(--color-primary-500)]"
          lang={lang === "en" ? "es" : "en"}
          aria-label={lang === "en" ? "Ver sitio en español" : "View site in English"}
        >
          {languageLabel}
        </a>
        <ThemeToggle lang={lang} />
      </div>
    </div>
  </nav>
</header>

<style>
  .mobile-menu-btn.open .menu-icon { display: none; }
  .mobile-menu-btn.open .close-icon { display: block; }

  @media (max-width: 1023px) {
    .nav-links {
      position: fixed;
      inset: 4rem 0 0;
      flex-direction: column;
      align-items: stretch;
      padding: 2rem;
      background-color: var(--bg-primary);
      transform: translateX(100%);
      transition: transform 0.25s ease;
    }
    .nav-links.open { display: flex; transform: translateX(0); }
    .nav-links ul { flex-direction: column; width: 100%; }
    .nav-links li, .nav-links a { width: 100%; }
    .nav-links a { padding: 0.9rem; text-align: center; }
    .nav-links > div { justify-content: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-links { transition: none; }
  }
</style>

<script>
  function initMobileMenu() {
    const menuBtn = document.getElementById("mobile-menu-btn");
    const navLinks = document.getElementById("nav-links");
    if (!menuBtn || !navLinks || menuBtn.dataset.initialized === "true") return;

    menuBtn.dataset.initialized = "true";
    menuBtn.addEventListener("click", () => {
      const isOpen = menuBtn.classList.toggle("open");
      navLinks.classList.toggle("open", isOpen);
      menuBtn.setAttribute("aria-expanded", String(isOpen));
    });

    navLinks.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        menuBtn.classList.remove("open");
        navLinks.classList.remove("open");
        menuBtn.setAttribute("aria-expanded", "false");
      });
    });
  }

  initMobileMenu();
  document.addEventListener("astro:after-swap", initMobileMenu);
</script>
